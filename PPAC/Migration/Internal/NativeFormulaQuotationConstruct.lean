import PPAC.Migration.Internal.FormulaQuotationLogicalSteps

/-! 全11原生公式构造的实际混合替换quotation构造；子码、后继长度和提升双表均在对象量词中取得。 -/
namespace PPAC.Migration.Internal.NativeFormulaQuotationConstruct
open Source SourceAlgebra SourceLogic OmegaSyntax NativeSubstitutionSyntax
open SyntaxRenameQuerySyntax (of_eq)
attribute [local irreducible] NaturalRecursionSyntax.matrix

theorem construct {m} {Γ : Context m} (hZ : ZFContext.Evidence Γ) {sb sf : PureSyntaxQuotation.Ctx}
    (input : PureSyntaxQuotation.Fm sb sf) {tb tf : PureSyntaxQuotation.Ctx} (σ : Mapping sb tb tf) (τ : Mapping sf tb tf)
    (w R S a b c d n q : Fin m) (hw : Derives Γ (omega w))
    (ha : Derives Γ (SyntaxNumeralSyntax.numeral sb.length a)) (hb : Derives Γ (SyntaxNumeralSyntax.numeral sf.length b))
    (hc : Derives Γ (SyntaxNumeralSyntax.numeral tb.length c)) (hd : Derives Γ (SyntaxNumeralSyntax.numeral tf.length d))
    (he : Derives Γ (environment σ τ w a b c d R S)) (hn : Derives Γ (PureQuotationSyntax.formula input w n))
    (hq : Derives Γ (PureQuotationSyntax.formula (input.substituteMapped σ τ) w q)) :
    Derives Γ (SyntaxMixedFormulaJudgmentSyntax.substituted w R S a b c d n q) := by
  induction input generalizing m tb tf with
  | @falsum sb sf =>
    have hi : Derives Γ (SyntaxMixedFormulaOutputSyntax.input w R S a b c d n) := .conjI (PureQuotationFormulaTyping.formula_type hZ (.falsum : PureSyntaxQuotation.Fm sb sf) w a b n hw ha hb hn) (.conjR he)
    have ho := FormulaQuotationAtomicSteps.nullary hZ false w R S a b c d n q hw hi hn hq
    exact ho

  | @truth sb sf =>
    have hi : Derives Γ (SyntaxMixedFormulaOutputSyntax.input w R S a b c d n) := .conjI (PureQuotationFormulaTyping.formula_type hZ (.truth : PureSyntaxQuotation.Fm sb sf) w a b n hw ha hb hn) (.conjR he)
    have ho := FormulaQuotationAtomicSteps.nullary hZ true w R S a b c d n q hw hi hn hq
    exact ho

  | @equal sb sf sort left right =>
    cases sort
    have hi : Derives Γ (SyntaxMixedFormulaOutputSyntax.input w R S a b c d n) := .conjI (PureQuotationFormulaTyping.formula_type hZ (.equal left right : PureSyntaxQuotation.Fm sb sf) w a b n hw ha hb hn) (.conjR he)
    have hex1 := OriginalTreeQuotationExistence.tree_exists hZ (PureSyntaxQuotation.termTree (left)) w hw
    let P1 := (Formula.mem (Fin.last m) w.castSucc).conj (PureQuotationSyntax.term (left) w.castSucc (Fin.last m))
    let Δ1 := Context.add P1 (Context.image Formula.raise (Γ))
    apply Derives.exE (p := P1) hex1
    have hZ1 := ZFContext.under hZ P1
    have hw1 : Derives Δ1 (omega w.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw P1)
    have ha1 : Derives Δ1 (SyntaxNumeralSyntax.numeral sb.length a.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha P1)
    have hb1 : Derives Δ1 (SyntaxNumeralSyntax.numeral sf.length b.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb P1)
    have hc1 : Derives Δ1 (SyntaxNumeralSyntax.numeral tb.length c.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc P1)
    have hd1 : Derives Δ1 (SyntaxNumeralSyntax.numeral tf.length d.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd P1)
    have he1 : Derives Δ1 (NativeSubstitutionSyntax.environment σ τ w.castSucc a.castSucc b.castSucc c.castSucc d.castSucc R.castSucc S.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he P1)
    have hn1 : Derives Δ1 (PureQuotationSyntax.formula (.equal left right : PureSyntaxQuotation.Fm sb sf) w.castSucc n.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hn P1)
    have hq1 : Derives Δ1 (PureQuotationSyntax.formula ((.equal left right : PureSyntaxQuotation.Fm sb sf).substituteMapped σ τ) w.castSucc q.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hq P1)
    have hi1 : Derives Δ1 (SyntaxMixedFormulaOutputSyntax.input w.castSucc R.castSucc S.castSucc a.castSucc b.castSucc c.castSucc d.castSucc n.castSucc) := of_eq (by simp only [Formula.raise, SyntaxMixedFormulaOutputSyntax.input_rename]) (under hi P1)
    have hQx1 : Derives Δ1 (PureQuotationSyntax.term (left) w.castSucc (Fin.last m)) := .conjR (.hyp (Or.inl rfl) : Derives Δ1 P1)
    have hex2 := OriginalTreeQuotationExistence.tree_exists hZ1 (PureSyntaxQuotation.termTree (right)) w.castSucc hw1
    let P2 := (Formula.mem (Fin.last (m+1)) w.castSucc.castSucc).conj (PureQuotationSyntax.term (right) w.castSucc.castSucc (Fin.last (m+1)))
    let Δ2 := Context.add P2 (Context.image Formula.raise (Δ1))
    apply Derives.exE (p := P2) hex2
    have hZ2 := ZFContext.under hZ1 P2
    have hw2 : Derives Δ2 (omega w.castSucc.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw1 P2)
    have ha2 : Derives Δ2 (SyntaxNumeralSyntax.numeral sb.length a.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha1 P2)
    have hb2 : Derives Δ2 (SyntaxNumeralSyntax.numeral sf.length b.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb1 P2)
    have hc2 : Derives Δ2 (SyntaxNumeralSyntax.numeral tb.length c.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc1 P2)
    have hd2 : Derives Δ2 (SyntaxNumeralSyntax.numeral tf.length d.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd1 P2)
    have he2 : Derives Δ2 (NativeSubstitutionSyntax.environment σ τ w.castSucc.castSucc a.castSucc.castSucc b.castSucc.castSucc c.castSucc.castSucc d.castSucc.castSucc R.castSucc.castSucc S.castSucc.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he1 P2)
    have hn2 : Derives Δ2 (PureQuotationSyntax.formula (.equal left right : PureSyntaxQuotation.Fm sb sf) w.castSucc.castSucc n.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hn1 P2)
    have hq2 : Derives Δ2 (PureQuotationSyntax.formula ((.equal left right : PureSyntaxQuotation.Fm sb sf).substituteMapped σ τ) w.castSucc.castSucc q.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hq1 P2)
    have hi2 : Derives Δ2 (SyntaxMixedFormulaOutputSyntax.input w.castSucc.castSucc R.castSucc.castSucc S.castSucc.castSucc a.castSucc.castSucc b.castSucc.castSucc c.castSucc.castSucc d.castSucc.castSucc n.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxMixedFormulaOutputSyntax.input_rename]) (under hi1 P2)
    have hQx2 : Derives Δ2 (PureQuotationSyntax.term (left) w.castSucc.castSucc (Fin.last m).castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQx1 P2)
    have hQy2 : Derives Δ2 (PureQuotationSyntax.term (right) w.castSucc.castSucc (Fin.last (m+1))) := .conjR (.hyp (Or.inl rfl) : Derives Δ2 P2)
    have hex3 := OriginalTreeQuotationExistence.tree_exists hZ2 (PureSyntaxQuotation.termTree (left.substituteMapped σ τ)) w.castSucc.castSucc hw2
    let P3 := (Formula.mem (Fin.last (m+2)) w.castSucc.castSucc.castSucc).conj (PureQuotationSyntax.term (left.substituteMapped σ τ) w.castSucc.castSucc.castSucc (Fin.last (m+2)))
    let Δ3 := Context.add P3 (Context.image Formula.raise (Δ2))
    apply Derives.exE (p := P3) hex3
    have hZ3 := ZFContext.under hZ2 P3
    have hw3 : Derives Δ3 (omega w.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw2 P3)
    have ha3 : Derives Δ3 (SyntaxNumeralSyntax.numeral sb.length a.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha2 P3)
    have hb3 : Derives Δ3 (SyntaxNumeralSyntax.numeral sf.length b.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb2 P3)
    have hc3 : Derives Δ3 (SyntaxNumeralSyntax.numeral tb.length c.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc2 P3)
    have hd3 : Derives Δ3 (SyntaxNumeralSyntax.numeral tf.length d.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd2 P3)
    have he3 : Derives Δ3 (NativeSubstitutionSyntax.environment σ τ w.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he2 P3)
    have hn3 : Derives Δ3 (PureQuotationSyntax.formula (.equal left right : PureSyntaxQuotation.Fm sb sf) w.castSucc.castSucc.castSucc n.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hn2 P3)
    have hq3 : Derives Δ3 (PureQuotationSyntax.formula ((.equal left right : PureSyntaxQuotation.Fm sb sf).substituteMapped σ τ) w.castSucc.castSucc.castSucc q.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hq2 P3)
    have hi3 : Derives Δ3 (SyntaxMixedFormulaOutputSyntax.input w.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc n.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxMixedFormulaOutputSyntax.input_rename]) (under hi2 P3)
    have hQx3 : Derives Δ3 (PureQuotationSyntax.term (left) w.castSucc.castSucc.castSucc (Fin.last m).castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQx2 P3)
    have hQy3 : Derives Δ3 (PureQuotationSyntax.term (right) w.castSucc.castSucc.castSucc (Fin.last (m+1)).castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQy2 P3)
    have hQX3 : Derives Δ3 (PureQuotationSyntax.term (left.substituteMapped σ τ) w.castSucc.castSucc.castSucc (Fin.last (m+2))) := .conjR (.hyp (Or.inl rfl) : Derives Δ3 P3)
    have hex4 := OriginalTreeQuotationExistence.tree_exists hZ3 (PureSyntaxQuotation.termTree (right.substituteMapped σ τ)) w.castSucc.castSucc.castSucc hw3
    let P4 := (Formula.mem (Fin.last (m+3)) w.castSucc.castSucc.castSucc.castSucc).conj (PureQuotationSyntax.term (right.substituteMapped σ τ) w.castSucc.castSucc.castSucc.castSucc (Fin.last (m+3)))
    let Δ4 := Context.add P4 (Context.image Formula.raise (Δ3))
    apply Derives.exE (p := P4) hex4
    have hZ4 := ZFContext.under hZ3 P4
    have hw4 : Derives Δ4 (omega w.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw3 P4)
    have ha4 : Derives Δ4 (SyntaxNumeralSyntax.numeral sb.length a.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha3 P4)
    have hb4 : Derives Δ4 (SyntaxNumeralSyntax.numeral sf.length b.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb3 P4)
    have hc4 : Derives Δ4 (SyntaxNumeralSyntax.numeral tb.length c.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc3 P4)
    have hd4 : Derives Δ4 (SyntaxNumeralSyntax.numeral tf.length d.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd3 P4)
    have he4 : Derives Δ4 (NativeSubstitutionSyntax.environment σ τ w.castSucc.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he3 P4)
    have hn4 : Derives Δ4 (PureQuotationSyntax.formula (.equal left right : PureSyntaxQuotation.Fm sb sf) w.castSucc.castSucc.castSucc.castSucc n.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hn3 P4)
    have hq4 : Derives Δ4 (PureQuotationSyntax.formula ((.equal left right : PureSyntaxQuotation.Fm sb sf).substituteMapped σ τ) w.castSucc.castSucc.castSucc.castSucc q.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hq3 P4)
    have hi4 : Derives Δ4 (SyntaxMixedFormulaOutputSyntax.input w.castSucc.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc.castSucc n.castSucc.castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxMixedFormulaOutputSyntax.input_rename]) (under hi3 P4)
    have hQx4 : Derives Δ4 (PureQuotationSyntax.term (left) w.castSucc.castSucc.castSucc.castSucc (Fin.last m).castSucc.castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQx3 P4)
    have hQy4 : Derives Δ4 (PureQuotationSyntax.term (right) w.castSucc.castSucc.castSucc.castSucc (Fin.last (m+1)).castSucc.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQy3 P4)
    have hQX4 : Derives Δ4 (PureQuotationSyntax.term (left.substituteMapped σ τ) w.castSucc.castSucc.castSucc.castSucc (Fin.last (m+2)).castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.term_rename]) (under hQX3 P4)
    have hQY4 : Derives Δ4 (PureQuotationSyntax.term (right.substituteMapped σ τ) w.castSucc.castSucc.castSucc.castSucc (Fin.last (m+3))) := .conjR (.hyp (Or.inl rfl) : Derives Δ4 P4)
    have hsL := Derives.impE (.conjR (NativeTermQuotationSubstitution.term_iff hZ4 σ τ left w.castSucc.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc.castSucc (Fin.last m).castSucc.castSucc.castSucc (Fin.last (m+2)).castSucc hw4 ha4 hb4 he4 hQx4)) hQX4
    have hsR := Derives.impE (.conjR (NativeTermQuotationSubstitution.term_iff hZ4 σ τ right w.castSucc.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc.castSucc (Fin.last (m+1)).castSucc.castSucc (Fin.last (m+3)) hw4 ha4 hb4 he4 hQy4)) hQY4
    have ho := FormulaQuotationAtomicSteps.equality hZ4 (PureSyntaxQuotation.termTree (left)) (PureSyntaxQuotation.termTree (right)) (PureSyntaxQuotation.termTree (left.substituteMapped σ τ)) (PureSyntaxQuotation.termTree (right.substituteMapped σ τ)) w.castSucc.castSucc.castSucc.castSucc R.castSucc.castSucc.castSucc.castSucc S.castSucc.castSucc.castSucc.castSucc a.castSucc.castSucc.castSucc.castSucc b.castSucc.castSucc.castSucc.castSucc c.castSucc.castSucc.castSucc.castSucc d.castSucc.castSucc.castSucc.castSucc n.castSucc.castSucc.castSucc.castSucc q.castSucc.castSucc.castSucc.castSucc (Fin.last m).castSucc.castSucc.castSucc (Fin.last (m+1)).castSucc.castSucc (Fin.last (m+2)).castSucc (Fin.last (m+3)) hw4 hi4 hn4 hq4 hQx4 hQy4 hQX4 hQY4 hsL hsR
    exact of_eq (by simp only [Formula.raise, SyntaxMixedFormulaJudgmentSyntax.substituted_rename]) ho

  | @rel sb sf symbol args =>
    cases symbol
    match args with
    | .cons left (.cons right .nil) =>
      have hi : Derives Γ (SyntaxMixedFormulaOutputSyntax.input w R S a b c d n) := .conjI (PureQuotationFormulaTyping.formula_type hZ (.rel .membership (.cons left (.cons right .nil)) : PureSyntaxQuotation.Fm sb sf) w a b n hw ha hb hn) (.conjR he)
      have hex1 := OriginalTreeQuotationExistence.tree_exists hZ (YesMetaZFC.Logic.FirstOrder.FormalSystem.ProofT.NatPacket.leaf 0) w hw
      let P1 := (Formula.mem (Fin.last m) w.castSucc).conj (OriginalTreeQuotationSyntax.tree (YesMetaZFC.Logic.FirstOrder.FormalSystem.ProofT.NatPacket.leaf 0) w.castSucc (Fin.last m))
      let Δ1 := Context.add P1 (Context.image Formula.raise (Γ))
      apply Derives.exE (p := P1) hex1
      have hZ1 := ZFContext.under hZ P1
      have hw1 : Derives Δ1 (omega w.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw P1)
      have ha1 : Derives Δ1 (SyntaxNumeralSyntax.numeral sb.length a.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha P1)
      have hb1 : Derives Δ1 (SyntaxNumeralSyntax.numeral sf.length b.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb P1)
      have hc1 : Derives Δ1 (SyntaxNumeralSyntax.numeral tb.length c.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc P1)
      have hd1 : Derives Δ1 (SyntaxNumeralSyntax.numeral tf.length d.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd P1)
      have he1 : Derives Δ1 (NativeSubstitutionSyntax.environment σ τ w.castSucc a.castSucc b.castSucc c.castSucc d.castSucc R.castSucc S.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he P1)
      have hn1 : Derives Δ1 (PureQuotationSyntax.formula (.rel .membership (.cons left (.cons right .nil)) : PureSyntaxQuotation.Fm sb sf) w.castSucc n.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hn P1)
      have hq1 : Derives Δ1 (PureQuotationSyntax.formula ((.rel .membership (.cons left (.cons right .nil)) : PureSyntaxQuotation.Fm sb sf).substituteMapped σ τ) w.castSucc q.castSucc) := of_eq (by simp only [Formula.raise, PureQuotationSyntax.formula_rename]) (under hq P1)
      have hi1 : Derives Δ1 (SyntaxMixedFormulaOutputSyntax.input w.castSucc R.castSucc S.castSucc a.castSucc b.castSucc c.castSucc d.castSucc n.castSucc) := of_eq (by simp only [Formula.raise, SyntaxMixedFormulaOutputSyntax.input_rename]) (under hi P1)
      have hQz1 : Derives Δ1 (OriginalTreeQuotationSyntax.tree (YesMetaZFC.Logic.FirstOrder.FormalSystem.ProofT.NatPacket.leaf 0) w.castSucc (Fin.last m)) := .conjR (.hyp (Or.inl rfl) : Derives Δ1 P1)
      have hex2 := OriginalTreeQuotationExistence.tree_exists hZ1 (PureSyntaxQuotation.termTree (left)) w.castSucc hw1
      let P2 := (Formula.mem (Fin.last (m+1)) w.castSucc.castSucc).conj (PureQuotationSyntax.term (left) w.castSucc.castSucc (Fin.last (m+1)))
      let Δ2 := Context.add P2 (Context.image Formula.raise (Δ1))
      apply Derives.exE (p := P2) hex2
      have hZ2 := ZFContext.under hZ1 P2
      have hw2 : Derives Δ2 (omega w.castSucc.castSucc) := of_eq (by simp only [Formula.raise, omega_rename]) (under hw1 P2)
      have ha2 : Derives Δ2 (SyntaxNumeralSyntax.numeral sb.length a.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under ha1 P2)
      have hb2 : Derives Δ2 (SyntaxNumeralSyntax.numeral sf.length b.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hb1 P2)
      have hc2 : Derives Δ2 (SyntaxNumeralSyntax.numeral tb.length c.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hc1 P2)
      have hd2 : Derives Δ2 (SyntaxNumeralSyntax.numeral tf.length d.castSucc.castSucc) := of_eq (by simp only [Formula.raise, SyntaxNumeralSyntax.numeral_rename]) (under hd1 P2)
      have he2 : Derives Δ2 (NativeSubstitutionSyntax.environment σ τ w.castSucc.castSucc a.castSucc.castSucc b.castSucc.castSucc c.castSucc.castSucc d.castSucc.castSucc R.castSucc.castSucc S.castSucc.castSucc) := of_eq (by simp only [Formula.raise, NativeSubstitutionSyntax.environment_rename]) (under he1 P2)
